<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54">
        <!-- Speech Bubble Body -->
        <path
            android:pathData="M32,32 h44 c4.4,0 8,3.6 8,8 v24 c0,4.4 -3.6,8 -8,8 h-22 l-10,9 v-9 h-12 c-4.4,0 -8,-3.6 -8,-8 v-24 c0,-4.4 3.6,-8 8,-8 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="24"
                    android:startY="32"
                    android:endX="84"
                    android:endY="72"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#38BDF8" />
                    <item android:offset="1.0" android:color="#6366F1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Sound wave bars inside left bubble side -->
        <!-- Center bar -->
        <path
            android:pathData="M44,44 v16"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.2"
            android:strokeLineCap="round" />
        <!-- Left bar -->
        <path
            android:pathData="M38,48 v8"
            android:strokeColor="#E0F2FE"
            android:strokeWidth="3.0"
            android:strokeLineCap="round" />
        <!-- Right bar -->
        <path
            android:pathData="M50,47 v10"
            android:strokeColor="#E0F2FE"
            android:strokeWidth="3.0"
            android:strokeLineCap="round" />

        <!-- Translation Character 'A' -->
        <path
            android:pathData="M62,60 L66.5,45 L71,60 M63.5,56.5 L69.5,56.5"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
