<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower (API 30 and below).
   Transcripts are private and ASR models are large and re-downloadable,
   so neither is backed up.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="liveaudio_translate.db" />
    <exclude domain="database" path="liveaudio_translate.db-shm" />
    <exclude domain="database" path="liveaudio_translate.db-wal" />
    <exclude domain="file" path="models" />
</full-backup-content>
