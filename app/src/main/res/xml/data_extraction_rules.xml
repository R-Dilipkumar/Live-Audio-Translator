<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 12 and higher (API 31+).
   Transcripts are private and ASR models are large and re-downloadable,
   so neither is sent to cloud backup. Models are also skipped on device transfer; history is
   kept on purpose, so it moves to the user's new phone. Recorded debug audio ("Save recognizer
   audio" developer option) is never backed up or transferred.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="liveaudio_translate.db" />
        <exclude domain="database" path="liveaudio_translate.db-shm" />
        <exclude domain="database" path="liveaudio_translate.db-wal" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="debug" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models" />
        <exclude domain="file" path="debug" />
    </device-transfer>
</data-extraction-rules>
